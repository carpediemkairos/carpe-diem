---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CARPE / DIEM — Premium DaVinci Resolve Video Editor",
  description = "Cinematic DaVinci Resolve editing across narrative, explainer, retention, and commercial content. Open for booking."
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://carpediem1.pages.dev').toString();
import Background from '../components/Background.astro';
import { ViewTransitions } from 'astro:transitions';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#05050a" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <!-- View Transitions (perf audit Step 12, 2026-08-05).
       One-line component that enables smooth crossfades between pages
       AND prefetches linked pages on hover. Users get an instant-feel
       nav experience with zero layout shift. Free prefetch + a11y
       announcement of page changes handled by Astro. -->
  <ViewTransitions />

  <!-- Web3Forms access key for the contact form.
       This key is send-only by design, so checking it in or leaking it is harmless.
       Free tier: 250 submissions/month. Manage at https://web3forms.com
       Destination inbox: carpediem.kairos1@gmail.com (set 2026-08-01). -->
  <meta name="web3forms-key" content="c18808c9-f652-42c1-a2f2-03f13c7cca17" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="CARPE / DIEM" />
  <meta property="og:image" content="/favicon.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/favicon.svg" />

  <title>{title}</title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preconnect to YouTube's CDN before the user clicks play.
       Step 8 (perf audit, 2026-08-05): the iframe only loads on click
       (lite-embed pattern), but starting the DNS handshake + TCP/TLS
       connection early makes the first click feel instant.
       youtube-nocookie.com is what Base.astro's openLightbox() embeds.
       i.ytimg.com serves the grid thumbnails. -->
  <link rel="preconnect" href="https://www.youtube-nocookie.com" />
  <link rel="preconnect" href="https://i.ytimg.com" />
  <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
  <link rel="dns-prefetch" href="https://i.ytimg.com" />

  <!-- Self-hosted fonts (3 variable files cover all 8 weights).
       Loads ~81 KB total vs ~600 KB from Google Fonts CDN.
       font-display: swap shows fallback text immediately, swaps in real font when ready. -->
  <link rel="preload" href="/fonts/Inter-VF.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Orbitron-VF.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline>
    /* Inter — variable font, weights 400/500/600/700 (300 dropped, unused) */
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url('/fonts/Inter-VF.woff2') format('woff2-variations'),
           url('/fonts/Inter-VF.woff2') format('woff2');
    }
    /* Orbitron — variable font, weights 700/900 (500 dropped, unused) */
    @font-face {
      font-family: 'Orbitron';
      font-style: normal;
      font-weight: 700 900;
      font-display: swap;
      src: url('/fonts/Orbitron-VF.woff2') format('woff2-variations'),
           url('/fonts/Orbitron-VF.woff2') format('woff2');
    }
    /* JetBrains Mono — variable font, weight 400 (NEW — was falling back to Menlo) */
    @font-face {
      font-family: 'JetBrains Mono';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/JetBrainsMono-VF.woff2') format('woff2-variations'),
           url('/fonts/JetBrainsMono-VF.woff2') format('woff2');
    }
  </style>

  <!-- ============================================================
       CRITICAL CSS (perf audit Step 10, 2026-08-05)
       Inlined so the browser can paint the above-the-fold content
       (navbar + hero + first showreel card) without waiting for the
       full ~88 KB stylesheet to download. The remaining CSS is
       preloaded and converted to a real stylesheet on DOMContentLoaded
       in the script below — no FOUC, no flash of unstyled text.

       What IS in critical CSS:
         - :root design tokens (variables consumed everywhere)
         - Base resets (body background, scrollbar, selection)
         - Fixed background layers (aurora, grids, noise, canvas)
         - Navbar (the whole bar — fixed top, must paint fast)
         - Hero chrome (buttons, profile ring, contact badges, status dot)
         - Hero statement + hero stats gradients
         - Showreel section preamble (the H2 + video card shell)
         - Mobile menu overlay (off by default, but layout must be set)
         - Reduced-motion overrides (always needed)

       What is NOT in critical CSS (loads with the deferred stylesheet):
         - Section-defer rules (Portfolio, Pipeline, Contact, Footer)
         - Lightbox detailed styles (only used when video opens)
         - Hover-only paints (shineSweep, badge-card hover, etc.)
         - Tablet/desktop placeholder rules
         - Pipeline / Portfolio / Contact / Footer component styles

       This split is the pattern fast sites use (used by Vercel, GitHub,
       etc.) — full CSS isn't blocking, just the first viewport.
       ============================================================ -->
  <style is:inline>
    /* ---- Design tokens ---- */
    :root {
      --space: #05050a;
      --deep: #0a0a14;
      --cyan: #00f2fe;
      --purple: #7000ff;
      --silver: #c0c0c0;
      --white: #ffffff;
      --green: #4ade80;
      --red: #ff4444;
      --glass-bg: rgba(15, 15, 25, 0.4);
      --glass-border: rgba(255, 255, 255, 0.08);
      --transition-fast: 0.2s ease;
      --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-spring: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* ---- Base resets ---- */
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--space);
      color: var(--white);
      min-height: 100vh;
      line-height: 1.6;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: var(--space); }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--cyan), var(--purple));
      border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--cyan); }
    ::selection { background: var(--cyan); color: var(--space); }

    /* ---- Body background gradient (the brand color wash) ---- */
    body {
      background:
        radial-gradient(1400px 900px at 12% 18%, rgba(112, 0, 255, 0.32), transparent 55%),
        radial-gradient(1200px 800px at 88% 78%, rgba(0, 242, 254, 0.28), transparent 55%),
        radial-gradient(900px 700px at 50% 110%, rgba(255, 0, 200, 0.14), transparent 60%),
        linear-gradient(180deg, #04040a 0%, #07071c 50%, #04040a 100%);
      background-attachment: fixed;
    }
    @media (min-width: 768px) and (max-width: 1366px) {
      body { background-attachment: scroll; }
    }

    /* ---- Fixed background layers ---- */
    .bg-gradient-aurora {
      position: fixed;
      inset: -10%;
      z-index: -4;
      background:
        conic-gradient(from 180deg at 50% 50%, rgba(0, 242, 254, 0.22), rgba(112, 0, 255, 0.22), rgba(255, 0, 200, 0.14), rgba(0, 242, 254, 0.22));
      filter: blur(70px) saturate(160%) contrast(110%);
      animation: auroraSpin 30s linear infinite, auroraDrift 18s ease-in-out infinite alternate;
      pointer-events: none;
      opacity: 0.9;
    }
    @keyframes auroraSpin { to { transform: rotate(360deg); } }
    @keyframes auroraDrift {
      0%   { translate: 0 0; }
      50%  { translate: 2% -1%; }
      100% { translate: -1% 1%; }
    }

    .bg-noise {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0.08;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.15' numOctaves='2' stitchTiles='stitch'/%3E%3CfeColorMatrix values='0 0 0 0 0.7  0 0 0 0 0.7  0 0 0 0 0.7  0 0 0 0.5 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(0, 242, 254, 0.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 242, 254, 0.18) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 85%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 85%);
      animation: gridDrift 40s linear infinite;
    }
    .bg-grid-fine {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 15px 15px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 0%, #000 60%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 0%, #000 60%, transparent 100%);
      animation: gridDriftReverse 60s linear infinite;
    }
    @keyframes gridDrift { to { background-position: 60px 60px, 60px 60px; } }
    @keyframes gridDriftReverse { to { background-position: -15px -15px, -15px -15px; } }

    #three-canvas {
      position: fixed;
      inset: 0;
      z-index: -3;
      pointer-events: none;
      opacity: 0.78;
    }
    @media (min-width: 768px) and (max-width: 1366px) {
      #three-canvas { opacity: 0.55; }
    }

    /* ---- Navbar (fixed top, must paint fast) ---- */
    .navbar-glass {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(0, 0, 0, 0) 35%),
        linear-gradient(180deg, rgba(6, 4, 18, 0.55) 0%, rgba(6, 4, 18, 0.25) 100%);
      backdrop-filter: blur(22px) saturate(170%);
      -webkit-backdrop-filter: blur(22px) saturate(170%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        inset 0 -1px 0 rgba(0, 0, 0, 0.4),
        0 8px 32px rgba(0, 0, 0, 0.45),
        0 1px 0 rgba(0, 242, 254, 0.08);
      isolation: isolate;
      overflow: hidden;
      transition:
        background 0.5s ease,
        box-shadow 0.5s ease,
        border-color 0.5s ease;
    }
    .navbar-aurora {
      position: absolute;
      inset: -10px 0 0 0;
      width: 180%;
      left: -40%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.55;
      filter: blur(36px) saturate(120%);
      background:
        radial-gradient(40% 70% at 18% 50%, rgba(0, 242, 254, 0.32), transparent 70%),
        radial-gradient(35% 60% at 50% 40%, rgba(112, 0, 255, 0.30), transparent 70%),
        radial-gradient(30% 60% at 82% 60%, rgba(255, 64, 200, 0.18), transparent 70%),
        radial-gradient(45% 60% at 95% 30%, rgba(0, 200, 255, 0.22), transparent 70%);
      animation: navbar-aurora-drift 24s ease-in-out infinite alternate;
    }
    @keyframes navbar-aurora-drift {
      0%   { transform: translate(0, 0)         rotate(0deg)   scale(1); }
      50%  { transform: translate(2%, -3%)      rotate(1.5deg) scale(1.04); }
      100% { transform: translate(-2%, 2%)      rotate(-1.5deg) scale(1.02); }
    }
    .navbar-conic {
      position: absolute;
      inset: -20% -10%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.30;
      filter: blur(50px) saturate(150%);
      background: conic-gradient(
        from 0deg at 50% 50%,
        rgba(0, 242, 254, 0.00) 0deg,
        rgba(0, 242, 254, 0.30) 40deg,
        rgba(112, 0, 255, 0.38) 110deg,
        rgba(255, 64, 200, 0.25) 180deg,
        rgba(0, 200, 255, 0.28) 250deg,
        rgba(112, 0, 255, 0.32) 320deg,
        rgba(0, 242, 254, 0.00) 360deg
      );
      animation: navbar-conic-spin 40s linear infinite;
    }
    @keyframes navbar-conic-spin { to { transform: rotate(360deg); } }
    .navbar-ridge {
      position: absolute;
      top: 1px;
      left: 0;
      right: 0;
      height: 10px;
      pointer-events: none;
      z-index: 1;
      background:
        radial-gradient(60% 100% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 70%),
        linear-gradient(90deg, transparent 0%, rgba(0, 242, 254, 0.18) 25%, rgba(255, 255, 255, 0.22) 50%, rgba(112, 0, 255, 0.18) 75%, transparent 100%);
      filter: blur(1.5px);
      opacity: 0.85;
    }
    .navbar-sheen {
      position: absolute;
      top: 0;
      left: -25%;
      width: 55%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      background: linear-gradient(
        115deg,
        transparent 0%,
        transparent 40%,
        rgba(255, 255, 255, 0.05) 50%,
        transparent 60%,
        transparent 100%
      );
      transform: skewX(-12deg);
      animation: navbar-sheen 14s linear infinite;
    }
    @keyframes navbar-sheen {
      0%   { left: -25%; }
      100% { left: 125%; }
    }
    .navbar-rim {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--cyan) 35%, var(--purple) 65%, transparent 100%);
      opacity: 0.7;
      pointer-events: none;
      z-index: 2;
    }
    .navbar-corner-tr,
    .navbar-corner-bl {
      position: absolute;
      pointer-events: none;
      z-index: 1;
      opacity: 0.85;
    }
    .navbar-corner-tr {
      top: -30px;
      right: -60px;
      width: 240px;
      height: 160px;
      background: radial-gradient(closest-side, rgba(0, 242, 254, 0.18), transparent 70%);
      filter: blur(8px);
    }
    .navbar-corner-bl {
      bottom: -50px;
      left: -60px;
      width: 240px;
      height: 180px;
      background: radial-gradient(closest-side, rgba(112, 0, 255, 0.20), transparent 70%);
      filter: blur(10px);
    }
    .navbar-mark {
      text-shadow: 0 0 14px rgba(0, 242, 254, 0.20);
      line-height: 1;
      text-decoration: none;
      transition: text-shadow var(--transition-base);
      position: relative;
      z-index: 3;
    }
    .navbar-mark:hover { text-shadow: 0 0 20px rgba(0, 242, 254, 0.45); }
    .navbar-mark .grad-cyan {
      background-image: linear-gradient(90deg, #ffffff 0%, var(--cyan) 40%, #b389ff 60%, var(--cyan) 80%, #ffffff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      background-size: 250% 100%;
      background-position: 0% 0%;
      animation: navbar-mark-holo 8s ease-in-out infinite;
    }
    .navbar-mark .grad-purple {
      background-image: linear-gradient(180deg, var(--cyan) 0%, var(--purple) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      background-size: 100% 200%;
      animation: navbar-mark-shimmer 6s ease-in-out infinite;
    }
    .navbar-mark .grad-white {
      background-image: linear-gradient(90deg, #d6d6e0 0%, #ffffff 30%, #d6d6e0 60%, #ffffff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      background-size: 250% 100%;
      background-position: 100% 0%;
      animation: navbar-mark-holo 8s ease-in-out infinite reverse;
    }
    @keyframes navbar-mark-shimmer {
      0%, 100% { background-position: 0% 0%; }
      50%      { background-position: 0% 100%; }
    }
    @keyframes navbar-mark-holo {
      0%   { background-position: 0% 0%; }
      50%  { background-position: 100% 0%; }
      100% { background-position: 0% 0%; }
    }

    /* ---- Buttons (hero CTAs) ---- */
    .btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      letter-spacing: 0.04em;
      border-radius: 0.75rem;
      cursor: pointer;
      overflow: hidden;
      transition: all var(--transition-base);
      text-decoration: none;
      white-space: nowrap;
      -webkit-user-select: none;
      user-select: none;
      border: none;
      line-height: 1.2;
    }
    .btn:active { transform: scale(0.97); }
    .btn svg {
      width: 1rem;
      height: 1rem;
      flex-shrink: 0;
    }
    .btn-primary {
      padding: 0.75rem 1.5rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, transparent 50%),
        linear-gradient(135deg, var(--cyan) 0%, #6a3dff 50%, var(--purple) 100%);
      color: var(--space);
      box-shadow:
        0 6px 16px rgba(0, 242, 254, 0.35),
        0 2px 4px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.4),
        inset 0 -2px 4px rgba(0, 0, 0, 0.2);
    }
    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.5) 50%, transparent 70%);
      transform: translateX(-100%);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
      pointer-events: none;
    }
    .btn-primary:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow:
        0 14px 30px rgba(0, 242, 254, 0.5),
        0 6px 12px rgba(112, 0, 255, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        inset 0 -2px 4px rgba(0, 0, 0, 0.2);
    }
    .btn-primary:hover::before { transform: translateX(100%); }
    .btn-primary > * { position: relative; z-index: 2; }
    .btn-secondary {
      padding: 0.75rem 1.5rem;
      background: var(--glass-bg);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      color: var(--cyan);
      border: 1.5px solid rgba(0, 242, 254, 0.4);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .btn-secondary:hover {
      background: rgba(0, 242, 254, 0.1);
      border-color: var(--cyan);
      color: var(--white);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 242, 254, 0.2);
    }
    .btn-lg { padding: 1rem 2rem; font-size: 1.0625rem; }
    .btn-block { width: 100%; }

    /* ---- Profile ring (the spinning conic gradient around the avatar) ---- */
    .profile-ring {
      background: conic-gradient(from 0deg, var(--cyan), var(--purple), var(--cyan));
      animation: rotateRing 6s linear infinite;
      filter: drop-shadow(0 0 12px rgba(0, 242, 254, 0.5));
    }
    .profile-ring::after {
      content: "";
      position: absolute;
      inset: 4px;
      border-radius: 50%;
      background: var(--space);
    }
    @keyframes rotateRing {
      to { transform: rotate(360deg); }
    }

    /* ---- Badge cards (the 4 contact cards in the hero) ---- */
    .badge-card {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding: 0.875rem 1rem;
      border-radius: 1rem;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 50%, rgba(255, 255, 255, 0.04) 100%),
        var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.35),
        0 2px 6px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        inset 0 -1px 0 rgba(0, 0, 0, 0.4);
      transition: all var(--transition-base);
      cursor: default;
      position: relative;
      overflow: hidden;
    }
    a.badge-card { cursor: pointer; }
    .badge-card.status-online {
      border-color: rgba(74, 222, 128, 0.3);
    }
    .badge-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(112, 0, 255, 0.15));
      font-size: 1.125rem;
      flex-shrink: 0;
    }
    .status-dot {
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 12px var(--green);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.3); opacity: 0.7; }
    }

    /* ---- Hero statement gradient text ---- */
    .hero-statement {
      font-family: 'Inter', sans-serif;
      font-size: clamp(1rem, 1.4vw, 1.25rem);
      line-height: 1.55;
      color: var(--silver);
      letter-spacing: 0.005em;
      border-left: 2px solid transparent;
      border-image: linear-gradient(180deg, var(--cyan), var(--purple)) 1;
      padding-left: 1rem;
      margin-left: 0;
      text-shadow: 0 0 22px rgba(0, 242, 254, 0.08);
    }
    .hero-statement__lead {
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 1.05em;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background-image: linear-gradient(90deg, var(--cyan) 0%, #ffffff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 0 14px rgba(0, 242, 254, 0.35));
    }
    .hero-statement__lead-soft {
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: 1em;
      letter-spacing: 0.005em;
