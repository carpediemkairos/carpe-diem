<body class="bg-space text-white font-inter antialiased overflow-x-hidden">

  <!-- Budget-device detection (added 2026-08-07, response to Realme C21 choppiness report).
       Runs SYNCHRONOUSLY before any paint so CSS can immediately apply cheaper
       styles to low-end phones. Targets: phones with <= 4 GB RAM (Catches Realme
       C21 which has 3-4 GB despite 8 cores — MediaTek Helio G35's weak Cortex-A53
       cores + slow PowerVR GE8320 GPU choke on backdrop-filter). hardwareConcurrency
       is a secondary signal: many budget chips report cores correctly, but the C21
       reports 8 (octa-core) so deviceMemory is the reliable primary. The .is-budget
       class lets the inlined critical CSS disable backdrop-filter, filter:blur,
       and the most expensive infinite animations. -->
  <script is:inline>
    (function () {
      try {
        var isPhone = window.matchMedia('(max-width: 768px)').matches;
        // Primary signal: RAM. 4 GB is the cutoff that reliably separates
        // budget (C21 = 3-4 GB, Infinix Hot = 2-3 GB) from mid-range (Pixel 7
        // = 8 GB, Galaxy A54 = 6-8 GB).
        var lowMem = navigator.deviceMemory !== undefined && navigator.deviceMemory <= 4;
        // Secondary signal: weak CPUs. Most budget chips underreport cores or
        // use slow A53 cores. >= 8 cores with <=4 GB RAM still catches the
        // C21 because the GPU is the bottleneck, not the cores.
        var lowCpu = navigator.hardwareConcurrency !== undefined && navigator.hardwareConcurrency <= 4;
        if (isPhone && (lowMem || lowCpu)) {
          document.documentElement.classList.add('is-budget');
        }
      } catch (e) { /* feature unsupported — assume modern device */ }
    })();
  </script>

