    .video-card__pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--cyan);
      opacity: 0.7;
      transform: scale(1);
      will-change: transform, opacity;
      animation: badgePulse 1.8s ease-out infinite;
    }
    @keyframes badgePulse {
      0%   { transform: scale(1);    opacity: 0.7; }
      70%  { transform: scale(2.25); opacity: 0;   }
      100% { transform: scale(2.25); opacity: 0;   }
