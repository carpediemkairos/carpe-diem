<body class="bg-space text-white font-inter antialiased overflow-x-hidden">

  <Background />

  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-3 focus:py-2 focus:rounded focus:bg-cyan focus:text-space">Skip to main content</a>

  <main id="main">
    <slot />
  </main>

  <!-- Lightbox — native <dialog> element (perf audit Step 14, 2026-08-05).
       The browser handles ESC-to-close, focus trap, inert background,
       click-outside-to-close, and screen reader announcements for free.
       Opened via lightbox.showModal() in JS; closed via lightbox.close().
       NOTE: do NOT add `fixed inset-0` here — the browser centers the
       modal natively. `fixed inset-0` makes the dialog fill the whole
       viewport, which puts the close button in a weird spot and squishes
       the video to a corner. The actual sizing lives in #lightbox[open]
       rules in global.css. -->
  <dialog id="lightbox" class="bg-transparent p-0 m-0 max-w-none max-h-none" aria-label="Video player">
    <div class="lightbox-frame">
      <!-- Close button: small, anchored to the top-right of the frame.
           Sized + positioned to sit in the dead space ABOVE YouTube's
           own player controls (⚙ Settings / CC / theater mode) at the
           very top-right of the iframe — not on top of them. The two
           UIs now occupy different vertical bands of the same corner
           instead of stacking on the same pixels. Real SVG X icon,
           glass + backdrop-blur, gradient ring + glow on hover. CSS
           handles hover/focus; JS auto-hides after 4s of mouse
           inactivity on desktop (mobile keeps it always visible
           because there's no hover state on touch). -->
      <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Close video player">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>

      <!-- ESC hint: appears for 3s after the dialog opens, then fades. -->
      <div id="lightbox-hint" class="lightbox-hint" aria-hidden="true">
        <kbd class="lightbox-kbd">Esc</kbd>
        <span>to close</span>
      </div>

      <div id="lightbox-content" class="w-full h-full flex items-center justify-center text-silver">
        <p class="font-orbitron text-sm tracking-widest">SELECT A PROJECT TO PLAY</p>
      </div>
    </div>
  </dialog>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-[110] glass-panel rounded-2xl px-5 py-4 max-w-xs hidden" role="status" aria-live="polite">
    <p id="toast-message" class="text-sm"></p>
  </div>

  <!-- Step 2 of the perf roadmap (2026-08-21): the main base-layout
       script was extracted to /scripts/main.js so it can be cached by
       the browser across pages instead of being inlined in every HTML
       response. `defer` preserves the original execution timing — runs
       after the HTML is fully parsed, before DOMContentLoaded, in
       document order. Identical behavior to the previous inline version.
       The body load order was:
         1. main.js   (deferred, runs first — this block)
         2. observer.js (deferred, runs second — see below) -->
  <script src="/scripts/main.js" defer></script>

  <style is:global>
    @import '../styles/global.css';

    /* ============================================================
       VIEW TRANSITIONS (perf audit Step 12, 2026-08-05)
       Subtle fade + tiny scale on navigation. Keeps the brand's
       cinematic feel — no flashy slides. Honors reduced-motion.
       Default transition: astro-transition-fade (220ms ease).
       ============================================================ */
    ::view-transition-old(root),
    ::view-transition-new(root) {
        animation-duration: 0.32s;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* Old page fades out + scales down 1% — feels like the page recedes */
    ::view-transition-old(root) {
        animation-name: vt-out;
    }
    /* New page fades in + scales up 1% — feels like it arrives forward */
    ::view-transition-new(root) {
        animation-name: vt-in;
    }
    @keyframes vt-out {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(0.99); }
    }
    @keyframes vt-in {
        from { opacity: 0; transform: scale(0.99); }
        to   { opacity: 1; transform: scale(1); }
    }

    /* Reduced motion: instant swap, no fade. Respects user preference. */
    @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation: none !important;
        }
    }
  </style>

  <!-- Step 2 of the perf roadmap (2026-08-21): the off-screen animation
       pause observer was extracted to /scripts/observer.js so it can be
       cached across pages. `defer` preserves the original execution
       timing — runs after HTML parse, after main.js (also deferred),
       before DOMContentLoaded. The body load order was:
         1. main.js   (deferred, runs first)
         2. observer.js (deferred, runs second — this block)
       Identical behavior to the previous inline version. -->
  <script src="/scripts/observer.js" defer></script>
</body>
</html>
