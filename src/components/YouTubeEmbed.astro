---
// Lite YouTube Embed.
// Renders only a thumbnail image + play button. The YouTube iframe
// (~500 KB JS + 2 MB requests) is NOT loaded until the user clicks.
//
// Usage:
//   <YouTubeEmbed videoId="dQw4w9WgXcQ" title="My Video" />
//
// When you don't have a video ID yet, pass an empty string and the
// component renders a "Video coming soon" placeholder — keeps the grid
// layout intact without loading anything.

interface Props {
  videoId?: string;
  title?: string;
  // Optional: render in compact mode (smaller play button). Useful for
  // tight grids; matches the existing .portfolio-thumb aspect ratio.
  compact?: boolean;
  // Optional: pick the YouTube thumbnail variant.
  //   'high' (default) → maxresdefault.jpg  (1280×720, ~231 KB)
  //   'low'            → mqdefault.jpg      (320×180,  ~23 KB)
  //
  // When to use 'low': the card is displayed under ~600px wide (mobile, or
  // compact secondary tiles in any layout). At that size mqdefault is
  // visually identical to maxresdefault and saves ~210 KB per embed. The
  // Hero passes resolution="low" to the mobile featured card for this
  // reason; the desktop featured card stays on 'high' because it renders
  // at ~1100px+ and would look soft on mqdefault.
  //
  // YouTube returns a 120×90 placeholder when maxres isn't available, so
  // 'high' degrades gracefully to the same image 'low' would have served.
  resolution?: 'high' | 'low';
  // Step 3 (perf roadmap, 2026-08-21): when true, defer the thumbnail
  // fetch via a `data-thumb-url` attribute + IntersectionObserver swap
  // (same pattern PortfolioGrid.astro already uses for its 24 grid
  // thumbs). Use for below-the-fold cards — the browser won't fetch
  // the ~20-230 KB thumbnail until the card scrolls within 200px of
  // the viewport, saving up to ~60 KB of initial bandwidth for the
  // showreel's 2 secondary cards. Defaults to false (eager load) so
  // above-the-fold callers don't need to think about it.
  lazy?: boolean;
}

const {
  videoId = '',
  title = 'YouTube video',
  compact = false,
  resolution = 'high',
  lazy = false,
} = Astro.props;

// YouTube thumbnail URL. We use maxresdefault for the cover image
// (1280x720) and mqdefault for compact secondary cards (320x180).
const thumbUrl = videoId
  ? `https://i.ytimg.com/vi/${videoId}/${resolution === 'low' ? 'mqdefault' : 'maxresdefault'}.jpg`
  : '';

// When lazy=true: render the thumbnail URL in a `data-thumb-url`
// attribute instead of as an inline `style="background-image: url(...)"`.
// The eager inline form forces the browser to fetch the image
// immediately on parse. The lazy form is just a string attribute —
// the browser can't do anything with it — so main.js sets the
// background-image only when the card scrolls near the viewport.
// When lazy=false: keep the existing eager inline form (no behavior
// change for above-the-fold callers).
---

{videoId ? (
  <button
    type="button"
    class={`yt-embed ${compact ? 'yt-embed--compact' : ''}`}
    data-yt-id={videoId}
    data-yt-title={title}
    data-thumb-url={thumbUrl}
    aria-label={`Play ${title} on YouTube`}
    {...(lazy
      ? {}  /* data-thumb-url above already carries the URL; lazy just means no inline background-image */
      : { style: `background-image: url('${thumbUrl}')` })}
  >
    <span class="yt-embed__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48">
        <path
          d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
          fill="#f00"
        />
        <path d="M45 24 27 14v20" fill="#fff" />
      </svg>
    </span>
  </button>
) : (
  <div
    class={`yt-placeholder ${compact ? 'yt-placeholder--compact' : ''}`}
    aria-label={`${title} — video coming soon`}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="2" />
      <path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none" />
    </svg>
    <span class="yt-placeholder__label">Video coming soon</span>
  </div>
)}

<!--
  Lite-embed button + placeholder + iframe styles live in global.css
  (search for "YOUTUBE LITE EMBED (shared — Hero + Portfolio grid)").
  They were scoped here originally, but PortfolioGrid.astro renders the
  same markup as a string template via set:html, which doesn't carry
  Astro's scoping attribute — so the scoped rules never matched the
  portfolio copies and the red play SVG sat unpositioned, hidden
  behind the thumbnail <img>. Hoisting to global makes both call sites
  work without forcing the portfolio to re-implement the embed.
-->


<script>
  // Click handler — swap the play-button thumbnail for an inline iframe
  // so the video plays in-place on the page (no lightbox / dialog).
  //
  // We use event delegation so one listener covers every .yt-embed on
  // the page (Hero cards, Portfolio filter cards, any future embeds).
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>('.yt-embed');
    if (!btn) return;
    e.stopPropagation(); // don't let the .video-card handler also fire
    const id = btn.dataset.ytId;
    const title = btn.dataset.ytTitle || 'YouTube video';
    if (!id) return; // placeholder has no video — let the card handler show "coming soon"

    // Stop any other video that was swapped in earlier by this same
    // handler. Without this, the user can play the showreel AND a
    // portfolio card AND another portfolio card, all at once — three
    // YouTube players running simultaneously, overlapping audio. The
    // fix: walk every [data-yt-embed-iframe] we previously created and
    // replace it with its original button markup (stored on the iframe
    // in data-yt-embed-original-btn before the swap). Setting the
    // iframe's src to about:blank isn't enough — the YouTube player
    // keeps running in the background until the iframe is unloaded.
    // Removing the iframe entirely tears down the player immediately.
    //
    // The restore logic is shared with main.js's
    // window.__restoreIframeToThumb — defined there because the
    // IntersectionObserver that auto-pauses out-of-viewport videos
    // also needs to call it. We attach the iframe to the observer
    // below, so the observer will pick it up when it leaves the
    // viewport and call the same restore function.
    document.querySelectorAll<HTMLElement>('[data-yt-embed-iframe]').forEach((oldIframe) => {
      // Drop the old iframe from the viewport observer before tearing
      // it down — otherwise the observer will fire one more time on
      // a node that no longer matters. The observer checks
      // isConnected + hasAttribute('data-yt-embed-iframe') defensively,
      // but unobserve is cheaper than the check + skip.
      const w = window as unknown as { __viewportObserver?: IntersectionObserver };
      if (w.__viewportObserver) w.__viewportObserver.unobserve(oldIframe);
      if (typeof (window as unknown as { __restoreIframeToThumb?: (el: HTMLElement) => void }).__restoreIframeToThumb === 'function') {
        (window as unknown as { __restoreIframeToThumb: (el: HTMLElement) => void }).__restoreIframeToThumb(oldIframe);
      } else {
        // Fallback if main.js hasn't loaded yet (very early click):
        // inline the same restore logic.
        const originalBtn = oldIframe.getAttribute('data-yt-embed-original-btn');
        const parent = oldIframe.parentElement;
        const oldCard = oldIframe.closest('[data-project-card], .video-card');
        if (oldCard) oldCard.removeAttribute('data-playing-embed');
        if (parent && originalBtn) {
          const tpl = document.createElement('template');
          tpl.innerHTML = originalBtn.trim();
          const restoredBtn = tpl.content.firstElementChild;
          if (restoredBtn) parent.replaceChild(restoredBtn, oldIframe);
        } else if (parent) {
          oldIframe.remove();
        }
      }
    });

    // Build the iframe in-place so the YouTube player fills the same
    // box the thumbnail was filling — same .yt-embed styles (position:
    // absolute, inset: 0) so it sizes to whatever the parent card is.
    const iframe = document.createElement('iframe');
    // youtube.com (not nocookie) + no enablejsapi — see the comment in
    // Base.astro for why those matter on Chrome-Android / Realme UI
    // WebView builds. autoplay=1 starts playback the moment the iframe
    // loads so the click feels immediate.
    iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
    iframe.title = title;
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;border-radius:inherit;background:#000;';
    // Mark the iframe so we can find it later (see the cleanup loop
    // above) and stash the original button's outerHTML so we can
    // restore the thumbnail when this video gets replaced.
    iframe.setAttribute('data-yt-embed-iframe', '');
    iframe.setAttribute('data-yt-embed-original-btn', btn.outerHTML);
    btn.replaceWith(iframe);

    // Mark the nearest portfolio card as "playing" so CSS can neutralize
    // the data-tilt transform on any ancestor that still has it (Hero
    // forms / Pipeline / Contact). Portfolio cards no longer carry
    // data-tilt, so for those this is effectively a marker only — kept
    // for consistency and so the playing-embed CSS hook still fires on
    // elements that opt into tilt elsewhere.
    const card = btn.closest('[data-project-card], .video-card');
    if (card) {
      card.setAttribute('data-playing-embed', '');
    }

    // Register the iframe with the viewport observer in main.js so it
    // pauses (and reverts to thumbnail) the moment it scrolls out of
    // view. Without this the audio keeps playing in the background
    // even though the user can't see the video. main.js exposes
    // __observePlayingIframe lazily — created on first call so a page
    // with no playing videos pays zero IntersectionObserver cost.
    const w = window as unknown as { __observePlayingIframe?: (el: HTMLElement) => void };
    if (typeof w.__observePlayingIframe === 'function') {
      w.__observePlayingIframe(iframe);
    }
  });
</script>