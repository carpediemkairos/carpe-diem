---
// Portfolio grid + filter tabs.
// Static Astro rendering — no React, no hydration.
//
// On first paint we render ONLY the cards matching the default filter
// (narrative + "all"). All other categories' cards are pre-rendered as
// HTML strings inside a <script type="application/json"> island so the
// filter script can swap them in instantly without any network request.

import { categories } from '../data/categories.ts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Sort projects by their declared `order` field
const sortedProjects = [...projects].sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

// Pre-render each project card as an HTML string, keyed by category+sub.
// The filter script picks the matching strings and swaps them in.
function renderCardHtml(item: CollectionEntry<'projects'>, i: number): string {
  const c = item.data.category;
  const s = item.data.subCategory;
  const title = item.data.title;
  const youtubeId = item.data.youtubeId || '';
  const video = item.data.video || '';
  const desc = item.data.desc;
  const tags = item.data.tags;
  // Grid thumbnails use mqdefault.jpg (320×180, ~20 KB) — true 16:9, no bars.
  // The earlier hqdefault.jpg (480×360) had black letterbox bars baked into the
  // 4:3 frame around the 16:9 video content, which made the card look like it
  // had empty space at the top even when the image filled the frame. mqdefault
  // is also lighter than hqdefault (~20 KB vs ~45 KB) and matches the 16:9 card
  // aspect ratio in global.css. The lightbox plays the iframe directly, so
  // maxresdefault (1280×720) isn't needed for click-to-play.
  const thumbUrl = youtubeId
    ? `https://i.ytimg.com/vi/${youtubeId}/mqdefault.jpg`
    : '';

  // Tags HTML
  const tagsHtml = tags
    .map((t: string) => `<span class="portfolio-tag">${t}</span>`)
    .join('');

  // Thumbnail — YouTube lite placeholder, or "coming soon" placeholder.
  // Lazy-loading (perf audit Step 2, 2026-08-05):
  //   Instead of `style="background-image:url('...')"` (which the browser
  //   fetches immediately, even for off-screen cards), we set the URL in
  //   a `data-thumb-url` attribute. The script in PortfolioFilter.astro
  //   uses IntersectionObserver to swap the URL into `style.backgroundImage`
  //   only when the card is within 200px of the viewport. With 24 cards
  //   this saves up to ~310 KB of wasted bandwidth when the visitor
  //   doesn't scroll to the bottom of the grid.
  //   `background-size: cover` and `background-position: center` stay
  //   inline because they're needed to fill the 16:9 card surface
  //   correctly. Without cover, the intrinsic 1280×720 image would
  //   render at top-left of the card and only show a quadrant.
  const thumbHtml = youtubeId
    ? `<button type="button" class="yt-embed" data-yt-id="${youtubeId}" data-yt-title="${title}" aria-label="Play ${title} on YouTube"><img src="${thumbUrl}" alt="${title}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block" /><span class="yt-embed__play" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg></span></button>`
    : `<div class="yt-placeholder" aria-label="${title} — video coming soon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M10 9l5 3-5 3V9z" fill="currentColor" stroke="none"/></svg><span class="yt-placeholder__label">Video coming soon</span></div>`;

  // Escape attributes that go into HTML
  const safeTitle = String(title).replace(/"/g, '&quot;');

  return `<article data-project-card data-category="${c}" data-sub-category="${s}" data-slug="${item.slug}" data-title="${safeTitle}" data-youtube-id="${youtubeId}" data-video="${video}" class="portfolio-item" style="animation-delay:${i * 60}ms" role="button" tabindex="0" data-tilt="8" aria-label="Open ${safeTitle}"><div class="portfolio-thumb">${thumbHtml}</div><div class="portfolio-info"><div class="portfolio-tags">${tagsHtml}</div><h3 class="portfolio-title">${title}</h3><p class="portfolio-desc">${desc}</p></div></article>`;
}

// Build a map: { "narrative": { "all": [cardHtml, ...], "documentary": [...], ... }, ... }
const cardsByCategory: Record<string, Record<string, string[]>> = {};
for (const cat of categories) {
  cardsByCategory[cat.id] = { all: [] };
  for (const sub of cat.subs) {
    if (sub.id !== 'all') cardsByCategory[cat.id][sub.id] = [];
  }
}

sortedProjects.forEach((p, i) => {
  const html = renderCardHtml(p, i);
  const c = p.data.category;
  const s = p.data.subCategory;
  cardsByCategory[c].all.push(html);
  if (cardsByCategory[c][s]) {
    cardsByCategory[c][s].push(html);
  }
});

// What to render initially: narrative + "all"
const initialCards = cardsByCategory['narrative'].all;
---

{/* Main Category Tabs */}
<div
  class="glass-panel glossy rounded-2xl p-2 sm:p-3 mb-8 reveal"
  data-reveal="up"
>
  <div
    class="grid grid-cols-2 lg:grid-cols-4 gap-2"
    role="tablist"
    aria-label="Project categories"
  >
    {categories.map((cat, i) => (
      <button
        type="button"
        role="tab"
        data-main-tab={cat.id}
        aria-selected={cat.id === 'narrative' ? 'true' : 'false'}
        class={`cat-tab ${cat.id === 'narrative' ? 'active' : ''}`}
      >
        <span class="cat-num">0{i + 1}</span>
        <span class="cat-name">{cat.label.split(' & ')[0]}</span>
      </button>
    ))}
  </div>
</div>

{/* Sub-Category Filters — one group per main category */}
{categories.map((cat) => (
  <div
    data-sub-group={cat.id}
    class={`flex flex-wrap justify-center gap-2 sm:gap-3 mb-10 reveal ${cat.id === 'narrative' ? '' : 'hidden'}`}
    data-reveal="up"
    role="group"
    aria-label={`${cat.label} sub-categories`}
  >
    {cat.subs.map((sub) => (
      <button
        type="button"
        data-sub-filter={sub.id}
        aria-pressed={sub.id === 'all' ? 'true' : 'false'}
        class={`sub-filter ${sub.id === 'all' ? 'active' : ''}`}
      >
        {sub.label}
      </button>
    ))}
  </div>
))}

{/* Portfolio Grid — only the active category's cards live here.
     The filter script swaps innerHTML on category/sub change. */}
<div
  id="portfolio-grid"
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6"
  set:html={initialCards.join('')}
/>

{/* Pre-rendered card HTML for every (category, sub) combo.
     The filter script reads this map and swaps cards into #portfolio-grid. */}
<script
  is:inline
  type="application/json"
  id="portfolio-cards-data"
  set:html={JSON.stringify(cardsByCategory)}
/>