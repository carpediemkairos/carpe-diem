---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Page Not Found" description="The page you're looking for has been cut from the timeline.">
  <section class="relative min-h-[80vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <p class="text-cyan text-xs sm:text-sm tracking-[0.4em] font-orbitron mb-3">ERROR 404</p>
      <h1 class="font-orbitron font-black text-5xl md:text-7xl mb-4 bg-gradient-to-r from-cyan via-purple to-cyan bg-clip-text text-transparent">RENDER FAILED</h1>
      <p class="text-silver mb-8">The clip you're looking for was trimmed out of the master. Let's get you back to the showcase.</p>
      <a href="#hero" class="btn btn-primary btn-lg">← Back to Home</a>
    </div>
  </section>
</Base>
